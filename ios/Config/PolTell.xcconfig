// Build settings for the PolTell iOS app. Do not edit this file for your own values:
// copy Local.xcconfig.example to Local.xcconfig (git-ignored) and set them there.

// Your Apple developer team id (Xcode › Settings › Accounts, or the "Team ID" in your membership details).
// Empty builds unsigned (CODE_SIGNING_ALLOWED=NO) or lets you pick the team in Xcode.
POLTELL_TEAM_ID =
// A bundle id unique to you: free Apple accounts need one nobody else has registered.
POLTELL_BUNDLE_ID = com.example.tether
// The name under the app icon.
POLTELL_DISPLAY_NAME = PolTell

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(POLTELL_TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER = $(POLTELL_BUNDLE_ID)
